# vi:ft=conf
#
# https://ghostty.org/docs/config/reference

auto-update-channel = tip
window-save-state = always
confirm-close-surface = false
shell-integration = zsh
shell-integration-features = no-cursor,title
copy-on-select = clipboard
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true
clipboard-read = "allow"
clipboard-paste-protection = false
window-inherit-working-directory=true
unfocused-split-opacity = 0.75

font-family = JetBrainsMono Nerd Font Mono
font-size = 10

theme = Kanagawabones

# resize splits
keybind = ctrl+right=resize_split:right,50
keybind = ctrl+down=resize_split:down,50
keybind = ctrl+left=resize_split:left,50
keybind = ctrl+up=resize_split:up,50

# New split commands
keybind = ctrl+space>-=new_split:down
keybind = ctrl+space>shift+\=new_split:right
keybind = ctrl+space>w>d=close_surface

# Навигация по панелям
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:top
keybind = alt+down=goto_split:bottom

# Изменение размера панелей
keybind = alt+shift+left=resize_split:left,10
keybind = alt+shift+right=resize_split:right,10
keybind = alt+shift+up=resize_split:up,10
keybind = alt+shift+down=resize_split:down,10

# Управление вкладками
keybind = alt+enter=new_tab
keybind = alt+q=close_surface
keybind = alt+z=toggle_split_zoom

# Переключение по номерам вкладок (Alt + 1..9)
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=goto_tab:9
